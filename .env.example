# Datenbank
DB_HOST=localhost
DB_PORT=5432
DB_USER=fixkosten
DB_PASSWORD=bitte-aendern
DB_NAME=fixkosten

# API
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Auth: "dev" = ohne Firebase lokal testen (Header x-dev-user optional). In Produktion leer lassen.
AUTH_MODE=dev
NODE_ENV=development

# E-Mail-Erinnerungen über Resend (HTTP-API, Port 443). Ohne Schlüssel: Mails nur im Log.
RESEND_API_KEY=
MAIL_FROM=Fixkosten <noreply@mail.guita.dev>

# Optional statt Resend: SMTP (Achtung: Hetzner blockiert ausgehend 25/465 bei neuen Servern)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Täglicher Versand (cron-Ausdruck, Zeitzone TZ). "off" = deaktiviert
REMINDERS_CRON=0 7 * * *
TZ=Europe/Berlin

# Firebase (nur ohne AUTH_MODE=dev nötig)
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json

# Frontend (werden beim Docker-Build eingebettet; Firebase-Konsole > Projekteinstellungen > Deine Apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
