{
  "name": "fixkosten-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend der Fixkosten-App (monatliche Ausgaben, Verträge, Kündigungsfristen)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/config/mikro-orm.config.ts",
      "./dist/config/mikro-orm.config.js"
    ]
  },
  "dependencies": {
    "@mikro-orm/core": "6.5.9",
    "@mikro-orm/migrations": "6.5.9",
    "@mikro-orm/postgresql": "6.5.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.3.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "6.5.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.9.3",
    "vitest": "^2.1.8"
  }
}
